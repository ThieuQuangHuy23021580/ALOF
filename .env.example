# ===========================================================
# App
# ===========================================================
APP_NAME=Adaptive Learning Multi-Agent API
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000
DATABASE_URL=sqlite:///database/adaptive_learning.db

# ===========================================================
# Gemini (other provider, optional)
# ===========================================================
GEMINI_API_KEY=your_gemini_key_here

# ===========================================================
# Groq — 5 keys in sequential fallback order
# ===========================================================
# Order of fallback: GROQ_API_KEY → NEW_GROQ_API_KEY →
#   GROQ_API_KEY_1 → GROQ_API_KEY_2 → GROQ_API_KEY_3
# For each key: try 3 models in priority order
#   gpt-oss-120b → gpt-oss-20b → qwen/qwen3.8-27b
# Override order via GROQ_KEY_ORDER=...
# Override models per slot via GROQ_KEY_MODELS_<slot>=m1,m2,m3

GROQ_API_KEY=gsk_your_first_key_here
NEW_GROQ_API_KEY=gsk_your_second_key_here
GROQ_API_KEY_1=gsk_your_third_key_here
GROQ_API_KEY_2=gsk_your_fourth_key_here
GROQ_API_KEY_3=gsk_your_fifth_key_here

# Optional: override key order
# GROQ_KEY_ORDER=GROQ_API_KEY,GROQ_API_KEY_1,GROQ_API_KEY_2,NEW_GROQ_API_KEY

# Optional: per-key model overrides (3 slots = 3 lines)
# GROQ_KEY_MODELS_0=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_KEY_MODELS_1=openai/gpt-oss-20b
# GROQ_KEY_MODELS_2=qwen/qwen3.8-27b,openai/gpt-oss-120b

# ===========================================================
# Evaluator (separate, not part of fallback pool)
# ===========================================================
JUDGE_API_KEY=gsk_judge_key_here
JUDGE_MODEL=qwen/qwen3.6-27b
JUDGE_BASE_URL=https://api.groq.com/openai/v1